{
  "redirects": [{ "source": "/index.html", "destination": "/", "permanent": true }],
  "headers": [
    { "source": "/media/cria500/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/fonts/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(styles.min.css|scripts.min.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
